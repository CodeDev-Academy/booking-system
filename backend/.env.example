# Django Configuration
DEBUG=False
SECRET_KEY=your-production-secret-key-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.up.railway.app

# Database Configuration (Neon PostgreSQL / Railway Postgres)
DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/neondb?sslmode=require

# CORS Configuration (Vercel Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Messaging & Automation Channels
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
N8N_WEBHOOK_URL=https://your-n8n.up.railway.app/webhook/intake-event

# Delivery-channel availability (Option B)
# Provider credentials live in n8n, not Django, so Django only needs to know
# whether each provider is live. These flags drive the availability resolver
# (booking-requests/{id}/channel-availability/ and the advisory delivery plan).
WHATSAPP_ENABLED=false
SMS_ENABLED=false
VOICE_ENABLED=false
# Enforcement (Layer 4). DEFAULT false = advisory only: a dispatch with no
# reachable channel still succeeds and is reported through delivery_warning.
# Set to true to refuse such a dispatch with 409 NO_REACHABLE_CHANNEL.
DISPATCH_REQUIRE_REACHABLE_CHANNEL=false

# Shared Webhook Secret (Phase 1 / Task 1.1)
# Sent by n8n as `X-Webhook-Secret` on every Django call (slots/hold, re-request,
# expiry-sweep, upcoming-reminders, interactions). REQUIRED in production:
# when DEBUG=False and no secret is configured, all guarded endpoints fail closed (403).
# n8n side must set the same value as its DJANGO_WEBHOOK_SECRET environment variable.
WEBHOOK_SECRET=generate-a-long-random-string-here
TELEGRAM_WEBHOOK_SECRET=generate-another-long-random-string-here

# Proxy Trust Toggles (Phase 1 / Task 1.4 + Review Fix #5)
# TRUST_PROXY_IP_HEADERS: master switch for edge ingress headers (CF-Connecting-IP,
#   X-Real-IP, X-Forwarded-For) used for client-IP rate limiting.
#   KEEP TRUE (default) on Railway/Cloudflare where REMOTE_ADDR is the edge proxy.
#   Set to FALSE only when the app is exposed directly (no reverse proxy).
# TRUSTED_PROXY_SETS_XFF: whether the platform proxy OVERWRITES (not appends)
#   X-Real-IP / X-Forwarded-For. If a proxy merely appends, the XFF first hop is
#   client-controlled and trusting it would allow rate-limit bypass via forged
#   IPs. Set to FALSE for platforms that only append.
TRUST_PROXY_IP_HEADERS=True
TRUSTED_PROXY_SETS_XFF=True

# JWT Security
JWT_SIGNING_KEY=your-jwt-signing-key
