# ---------------------------------------------------------------------------
# Django environment contract.
#
# Every name below is the name the code actually reads. The three that used to
# be wrong here (DEBUG, SECRET_KEY, ALLOWED_HOSTS) silently did nothing, which
# is how a deployment ends up running with a published signing key. Verified
# against backend/core/settings.py and the services on 2026-11-25.
#
# Generate a value, never copy an example:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------

# --- Core Django ------------------------------------------------------------
# DEBUG=True turns on the browsable API and error pages. Keep it False anywhere
# a patient's data can be reached.
DJANGO_DEBUG=False
# REQUIRED whenever DJANGO_DEBUG=False: the app refuses to start without it
# (security audit F4). In development an ephemeral key is generated per process,
# so signed-in sessions end on restart - that is intentional.
DJANGO_SECRET_KEY=
# Comma-separated host names, no scheme.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.up.railway.app
# PostgreSQL (Neon / Railway). Unset falls back to a SQLite file in backend/,
# which is wiped by an ephemeral container - never use that for real patients.
DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/neondb?sslmode=require

# --- CORS -------------------------------------------------------------------
# Only needed when the frontend is on a different origin than the API.
# Leave empty to use the built-in localhost development origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Telegram (the launch channel) ------------------------------------------
# Django sends Telegram messages itself, so the token lives here, not in n8n.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
# Header secret Telegram must present on /api/v1/webhooks/telegram/.
# Unset = every Telegram payload is refused (fail closed).
TELEGRAM_WEBHOOK_SECRET=

# --- Shared webhook secret (n8n <-> Django) ---------------------------------
# n8n sends this as `X-Webhook-Secret` on every Django write: slots/hold,
# re-request, expiry-sweep, reminder-sweep, patient-reply, interactions,
# disruption-claims. Resolution order is ClinicSetting.webhook_secret ->
# custom_config['webhook_secret'] -> WEBHOOK_SECRET here. There is no fallback
# value any more: nothing configured means every guarded endpoint answers 401,
# in DEBUG as well as in production (security audit F3).
# Set the SAME string in n8n as DJANGO_WEBHOOK_SECRET.
WEBHOOK_SECRET=

# --- n8n entry points Django calls ------------------------------------------
# Slot-offer dispatch (workflow 05). Unset = the n8n leg is skipped entirely.
N8N_DISPATCH_WEBHOOK_URL=https://your-n8n.up.railway.app/webhook/dispatch-offers
# Doctor-leave disruption notices (workflow 08). Unset = notices stay queued in
# Django and nothing is lost.
N8N_DISRUPTION_WEBHOOK_URL=https://your-n8n.up.railway.app/webhook/disruption-alerts

# --- Provider availability (advisory) ---------------------------------------
# These only tell the dashboard which channels a patient can actually be
# reached on. The credentials themselves live in n8n, never here.
WHATSAPP_ENABLED=false
SMS_ENABLED=false
VOICE_ENABLED=false
# Enforcement (Option B layer 4). false = advisory only: a dispatch that can
# reach nobody still succeeds and reports delivery_warning. true = refuse it
# with 409 NO_REACHABLE_CHANNEL before any offer is touched.
DISPATCH_REQUIRE_REACHABLE_CHANNEL=false

# --- Ingress header trust (rate limiting) -----------------------------------
# TRUST_PROXY_IP_HEADERS: master switch for CF-Connecting-IP, X-Real-IP and
#   X-Forwarded-For when deriving the client IP. Set false only when the app is
#   exposed directly with no reverse proxy.
# TRUSTED_PROXY_SETS_XFF: whether your proxy OVERWRITES those headers. If it
#   only appends, a client can rotate them and escape the booking rate limit,
#   so set false in that case. See audit F7.
TRUST_PROXY_IP_HEADERS=True
TRUSTED_PROXY_SETS_XFF=True

# --- Neon (optional, only if you use Neon Auth) -----------------------------
NEON_BRANCH=production
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
