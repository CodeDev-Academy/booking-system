# ---------------------------------------------------------------------------
# n8n environment contract — Workflow D (slot offer dispatch + provider callbacks)
#
# This is the ONLY place provider configuration lives. No node in
# 05_Slot_Offer_Dispatcher_Bridge or 07_Provider_Callback_Receiver hardcodes a
# URL, key or sender id.
#
# n8n reads these ONCE at process start. Changing any value requires a restart.
# The Code nodes read $env, which n8n blocks by default — keep
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false or every adapter/log node fails.
# ---------------------------------------------------------------------------

# --- Django (authoritative API) --------------------------------------------
# Docker Compose: http://backend:8000/api/v1     Local dev: http://127.0.0.1:8000/api/v1
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Must equal WEBHOOK_SECRET in backend/.env. Used in BOTH directions:
#   outbound -> every Django API call sends X-Webhook-Secret
#   inbound  -> /webhook/dispatch-offers rejects anything else with 401
# An unset value fails closed: Django's dispatch is refused, nothing is sent.
DJANGO_WEBHOOK_SECRET=clinic_dev_secret_2026

# --- Mock mode (dev, or while partner credentials are pending) -------------
# true  -> every provider URL points at 06_Provider_Simulator: the real HTTP
#          nodes, auth headers, JSON bodies and error path still run, but no
#          message or call leaves the machine.
# false -> the real provider APIs below are used.
PROVIDER_MOCK=true
# true -> the simulator answers HTTP 500, which exercises the Needs Attention path.
PROVIDER_MOCK_FAIL=false
PROVIDER_SIMULATOR_URL=http://127.0.0.1:5678/webhook/provider-sim

# --- VoiceBip (one account covers voice AND SMS) ---------------------------
VOICEBIP_API_URL=
VOICEBIP_API_KEY=
VOICEBIP_VOICE_AGENT_ID=
VOICEBIP_CALLER_ID=
VOICEBIP_SMS_SENDER_ID=Cedarcare
VOICE_SCRIPT_SOURCE=partner

# --- Meta WhatsApp Cloud (pre-wired; dormant until the account exists) -----
# Telegram is the launch channel. Everything below is inert while
# PROVIDER_MOCK=true, and the leg refuses to send in live mode until the
# template name is filled in (skip: whatsapp_template_not_configured).
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved template. Meta rejects free-form business-initiated text outside the
# 24-hour window (131047), so 'template' is the only correct live mode.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# Must match the approved template's {{1}}..{{n}} order exactly.
WHATSAPP_TEMPLATE_PARAM_ORDER=patient_name,service_name,option_1,option_2,option_3,expiry
# Meta allows at most 3 quick-reply buttons; the engine caps options to 3.
WHATSAPP_TEMPLATE_QUICK_REPLIES=true
# 'template' (default) | 'text' (only valid for in-window replies)
WHATSAPP_TEMPLATE_MODE=template
# The string you type into Meta's "Verify token" box. Also gates the
# GET ?hub.challenge= handshake in 07 — unset means every verification is 403.
WHATSAPP_VERIFY_TOKEN=

# --- Inbound provider callbacks (07_Provider_Callback_Receiver) ------------
# Shared secret the partner sends as ?token=... or X-Provider-Token.
# Leave EMPTY and every callback is rejected 401 (fail closed by design).
PROVIDER_CALLBACK_TOKEN=

# --- n8n runtime requirement ----------------------------------------------
# Code nodes use $env. n8n blocks that by default in the Code node.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
