        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Parse Callback & Intent').item.json.chat_id }}\",\n  \"text\": \"❌ <b>Appointment Cancelled</b>\\n\\nYour appointment has been cancelled. If you wish to schedule a new time in the future, simply tap /start or submit a new inquiry.\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "id": "node-send-cancel-ack",
      "name": "Send Cancelled Reply",
      "type": "n8n-nodes-base.httpRequest",
