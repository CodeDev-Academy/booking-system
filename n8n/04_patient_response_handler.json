                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "c-rereq",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "re_request_slots",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      },
