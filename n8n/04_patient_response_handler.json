        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + ($env.TELEGRAM_BOT_TOKEN || '') + '/sendMessage' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Parse Callback & Intent').item.json.chat_id }}\",\n  \"text\": \"✅ <b>Attendance Confirmed!</b>\\n\\nThank you for letting us know! We have confirmed your attendance with front desk.\\n\\nPlease arrive 10 minutes before your scheduled appointment time.\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "id": "node-send-attend-ack",
      "name": "Send Attendance Confirmed Reply",
      "type": "n8n-nodes-base.httpRequest",
