    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + ($env.TELEGRAM_BOT_TOKEN || '') + '/sendMessage' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Parse Callback & Intent').item.json.chat_id }}\",\n  \"text\": \"✅ <b>Booking Confirmed!</b>\\n\\nYour appointment has been locked in:\\n\\n🔖 <b>Reference ID:</b> <code>{{ $json.appointment_id || $json.id }}</code>\\n📅 <b>Time:</b> {{ $json.start_datetime ? new Date($json.start_datetime).toLocaleString() : 'Scheduled Time' }}\\n\\nWe look forward to seeing you at MedPulse Clinic!\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "id": "node-send-confirmation-card",
      "name": "Send Confirmation Card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 140]
