{
  "name": "04_Patient_Response_Interactive_Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "messaging/inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-inbound-webhook",
      "name": "Inbound Patient Response Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 360],
      "webhookId": "medpulse-messaging-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Parse incoming Telegram callback_query or text message\nconst item = $input.item.json;\nconst body = item.body || item;\n\nlet action = 'unknown';\nlet entityId = '';\nlet chatId = null;\nlet messageId = null;\nlet callbackQueryId = null;\nlet rawData = '';\n\nif (body.callback_query) {\n  const cq = body.callback_query;\n  callbackQueryId = cq.id;\n  chatId = (cq.message && cq.message.chat) ? cq.message.chat.id : cq.from.id;\n  messageId = cq.message ? cq.message.message_id : null;\n  rawData = cq.data || '';\n\n  if (rawData.startsWith('select_slot_')) {\n    action = 'select_slot';\n    entityId = rawData.replace('select_slot_', '');\n  } else if (rawData.startsWith('confirm_attend_')) {\n    action = 'confirm_attendance';\n    entityId = rawData.replace('confirm_attend_', '');\n  } else if (rawData.startsWith('cancel_')) {\n    action = 'cancel_booking';\n    entityId = rawData.replace('cancel_', '');\n  } else if (rawData.startsWith('re_request_slots_') || rawData.startsWith('re_request_')) {\n    action = 're_request_slots';\n    entityId = rawData.replace('re_request_slots_', '').replace('re_request_', '');\n  } else if (rawData.startsWith('reschedule_')) {\n    action = 'reschedule_request';\n    entityId = rawData.replace('reschedule_', '');\n  }\n} else if (body.message) {\n  // Regular text message or /start\n  const msg = body.message;\n  chatId = msg.chat ? msg.chat.id : msg.from.id;\n  const text = (msg.text || '').trim();\n  if (text.startsWith('/start')) {\n    action = 'start_command';\n  } else {\n    action = 'text_message';\n    entityId = text;\n  }\n}\n\nreturn {\n  json: {\n    action: action,\n    entity_id: entityId,\n    raw_data: rawData,\n    chat_id: chatId,\n    message_id: messageId,\n    callback_query_id: callbackQueryId\n  }\n};"
      },
      "id": "node-parse-callback",
      "name": "Parse Callback & Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 360]
    },
    {
      "parameters": {
