        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Parse Callback & Intent').item.json.chat_id }}\",\n  \"text\": \"⚡ <b>Front Desk Notified</b>\\n\\nWe received your request for fresh available times! Our receptionist has prioritized your card and will send new available slot options shortly.\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
