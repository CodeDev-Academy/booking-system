# Production API Base URL (Railway DRF backend).
#
# REQUIRED for a production build: `npm run build` refuses to start the app on
# a non-local host without this value (it will not guess where patient data
# goes). Must include /api/v1.
#
# Local development needs nothing here: on localhost / 127.0.0.1 / LAN
# addresses the app talks to http://<host>:8000/api/v1 directly (CORS is
# configured on the backend). There is NO Vite proxy in this project.
VITE_API_BASE_URL=https://your-backend.up.railway.app/api/v1
